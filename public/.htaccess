# Muuras — Apache config for static hosting (e.g. GoDaddy).
# Ships to the site root on build (Vite copies /public to /dist).

# Serve the prerendered per-route pages: /services -> /services/index.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonicalize the domain (must match the <link rel="canonical">) ---
  # 1) Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Drop the "www." prefix -> https://muuras.nl
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Each route is a real directory (/services/index.html), so mod_dir serves
# it directly and redirects the slash-less form (/services -> /services/) to
# match the trailing-slash <link rel="canonical">. Keep DirectorySlash on.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# Unknown URLs boot the SPA fallback (which then client-routes), and
# correctly report a 404 instead of a soft-200. Prerendered routes are real
# files, so they are served directly and never hit this.
ErrorDocument 404 /404.html

# --- Performance: compression + caching (helps Core Web Vitals / SEO) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets (JS/CSS/images) are safe to cache for a year.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  # HTML is regenerated each deploy — revalidate often.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
